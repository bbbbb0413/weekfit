# 복사해서 .env 로 사용한다. .env 는 커밋하지 않는다.
# LLM 제공사: anthropic(기본) | openai | google-genai
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# 가성비 제품 추천 전용 모델(기본 claude-sonnet-5-5). 바꿀 때만 주석을 푼다
# SHOPPING_FIND_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
# 모델을 바꾸려면 아래 주석을 풀고 모델명을 넣는다. 주석이면 Spring AI 기본 모델을 쓴다.
# SPRING_AI_OPENAI_CHAT_OPTIONS_MODEL=
GEMINI_API_KEY=
# SPRING_AI_GOOGLE_GENAI_CHAT_OPTIONS_MODEL=

DB_URL=jdbc:postgresql://localhost:15432/weekfit
DB_USERNAME=weekfit
DB_PASSWORD=weekfit

STORAGE_ENDPOINT=http://localhost:18333
STORAGE_REGION=us-east-1
STORAGE_BUCKET=clothes
STORAGE_ACCESS_KEY=local
STORAGE_SECRET_KEY=local

CORS_ALLOWED_ORIGINS=http://localhost:5173

