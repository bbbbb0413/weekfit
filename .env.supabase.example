# 복사해서 .env.supabase 로 사용한다. .env.supabase 는 커밋하지 않는다.
# 로컬 API 서버를 Supabase 에 붙일 때와 Render 환경 변수에 같은 값을 쓴다.

# Supabase 대시보드 > Connect > Session pooler
# (Direct connection 은 IPv6 전용이라 Render 에서 접속하지 못한다. Transaction pooler(6543)도 쓰지 않는다)
DB_URL=jdbc:postgresql://<pooler-host>:5432/postgres?sslmode=require
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=
DB_POOL_SIZE=5

# Supabase 대시보드 > Storage > Settings > S3 Configuration
# 버킷 modi 는 Storage 에서 비공개로 먼저 만들어 둔다
STORAGE_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
STORAGE_REGION=ap-northeast-1
STORAGE_BUCKET=modi
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
